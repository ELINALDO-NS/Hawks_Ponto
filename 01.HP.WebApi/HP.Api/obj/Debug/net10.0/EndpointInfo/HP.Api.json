  "paths": {
    "/Cargo": {
      "post": {
        "tags": [
          "Cargo"
        ],
        "summary": "Adiciona um novo Cargo",
        "description": "Recebe os dados cadastrais do Cargo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdicionaCargoDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CargoDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "get": {
        "tags": [
          "Cargo"
        ],
        "summary": "Obtem todos os Cargos.",
        "description": "Retorna uma lista contendo todos os Cargos cadastrados na Empresa. Caso não existam registros, retorna uma lista vazia.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CargoDto"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        }
      },
      "put": {
        "tags": [
          "Cargo"
        ],
        "summary": "Atualiza um Cargo",
        "description": "Altera as informações de um Cargo existente com base nos dados fornecidos no corpo da requisição.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizaCargoDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CargoDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/Cargo/{id}": {
      "get": {
        "tags": [
          "Cargo"
        ],
        "summary": "Obtem um Cargo por id",
        "description": "Retorna um Cargo específica com base no identificador único informado.",
