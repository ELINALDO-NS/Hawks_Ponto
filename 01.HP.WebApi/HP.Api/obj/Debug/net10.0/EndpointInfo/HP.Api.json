            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "Cargo"
        ],
        "summary": "Remove um Cargo",
        "description": "Exclui o registro de um Cargo do sistema permanentemente a partir do seu identificador único.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
